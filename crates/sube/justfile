default: check lint test

check:
    cargo check --no-default-features
    cargo check --features wss
    cargo check --features smoldot-std
    cargo check -p sube-cli

lint:
    cargo clippy --all-targets --features wss --no-deps -- -D warnings
    cargo clippy -p sube-cli --all-targets --no-deps -- -D warnings

test:
    cargo test --features wss
    cargo test --features wss --doc

test-integration:
    cargo test --features wss --test integration -- --ignored

check-thumbv7em:
    cargo check --target thumbv7em-none-eabihf --no-default-features
    cargo check --target thumbv7em-none-eabi --no-default-features --features ws-edge

check-riscv32:
    cargo check --target riscv32imac-unknown-none-elf --no-default-features

check-wasm:
    cargo check --target wasm32-unknown-unknown --no-default-features
    cargo check --target wasm32-unknown-unknown --features ws-web

check-xtensa:
    source ~/export-esp.sh && cargo +esp check --target xtensa-esp32s3-none-elf --no-default-features -Zbuild-std=core,alloc
    source ~/export-esp.sh && cargo +esp check --target xtensa-esp32s3-none-elf --no-default-features --features ws-edge -Zbuild-std=core,alloc

check-targets-ci: check-thumbv7em check-riscv32 check-wasm

check-targets: check-targets-ci check-xtensa

package:
    cargo package -p scale-serialization
    cargo package -p sube --list

test-qemu:
    cd tests/qemu && cargo build --target thumbv7em-none-eabihf --release
    qemu-system-arm \
        -cpu cortex-m4 \
        -machine lm3s6965evb \
        -nographic \
        -semihosting-config enable=on,target=native \
        -kernel tests/qemu/target/thumbv7em-none-eabihf/release/sube-qemu-test

ci: check lint test check-targets-ci test-qemu package
