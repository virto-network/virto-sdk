// Kreivo logo from sprite sheet: 8 paths × 2 states (grey/color), 80×70 each.
// Layout: [p0_grey .. p7_grey | p0_color .. p7_color] = 1280×70
component LogoLayer inherits Image {
    in property <int> index;
    in property <bool> on;
    source: @image-url("logo_sprite.png");
    width: 80px;
    height: 70px;
    source-clip-y: 0;
    source-clip-width: 80;
    source-clip-height: 70;
    source-clip-x: on ? (index + 8) * 80 : index * 80;
}

export component KreivoLogo inherits Rectangle {
    in property <bool> live: false;
    /// Set to 0-7 to light up one segment at a time, or -1 for no loading highlight.
    in property <int> loading-step: -1;

    property <bool> loading: !live && loading-step >= 0;

    width: 80px;
    height: 70px;
    LogoLayer { index: 0; on: live || (loading && loading-step == 0); }
    LogoLayer { index: 1; on: live || (loading && loading-step == 1); }
    LogoLayer { index: 2; on: live || (loading && loading-step == 2); }
    LogoLayer { index: 3; on: live || (loading && loading-step == 3); }
    LogoLayer { index: 4; on: live || (loading && loading-step == 4); }
    LogoLayer { index: 5; on: live || (loading && loading-step == 5); }
    LogoLayer { index: 6; on: live || (loading && loading-step == 6); }
    LogoLayer { index: 7; on: live || (loading && loading-step == 7); }
}

component CollatorBox inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;

    width: 66px;
    height: 24px;
    border-radius: 4px;
    background: active ? #1a2e24 : #141414;

    HorizontalLayout {
        alignment: center;
        padding-top: 5px;
        Text {
            text: root.text != "" ? root.text : "—";
            color: active ? #b5f1b1 : #444;
            font-size: 10px;
        }
    }
}

export component MainWindow inherits Window {
    width: 240px;
    height: 240px;
    background: #0d1f18;

    in property <string> status: "starting...";
    in property <color> status-color: #555555;
    in property <int> block-number: 0;
    in property <string> block-text: "";
    in property <bool> live: false;
    in property <bool> wifi: false;
    in property <int> battery-level: -1;
    in property <bool> charging: false;
    in property <int> loading-step: -1;
    in property <string> c0; in property <bool> c0-active;
    in property <string> c1; in property <bool> c1-active;
    in property <string> c2; in property <bool> c2-active;
    in property <string> c3; in property <bool> c3-active;
    in property <string> c4; in property <bool> c4-active;
    in property <string> c5; in property <bool> c5-active;
    in property <string> config-url: "";
    in property <bool> show-info: false;
    in property <int> meta-pallets: 0;
    in property <int> meta-types: 0;
    in property <bool> meta-saved: false;
    in property <int> heap-free: 0;

    property <color> grey: #3a3a3a;

    // --- Status bar ---
    Rectangle {
        y: 8px; height: 14px; width: 240px;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            alignment: space-between;
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 6px; height: 6px; y: 4px;
                    border-radius: 3px;
                    background: wifi ? #32cd32 : grey;
                }
                Text {
                    text: "wifi";
                    color: wifi ? #555 : #333;
                    font-size: 9px;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: battery-level >= 0 ? "\{battery-level}%" : "—";
                    color: battery-level > 20 ? #555 : battery-level >= 0 ? #ff4500 : #333;
                    font-size: 9px;
                }
                Rectangle {
                    width: 6px; height: 6px; y: 4px;
                    border-radius: 3px;
                    background: charging ? #ffbf00 : battery-level > 20 ? #32cd32 : battery-level >= 0 ? #ff4500 : grey;
                }
            }
        }
    }

    // ═══════════════════ MAIN PAGE ═══════════════════
    if !show-info: VerticalLayout {
        // --- Logo ---
        HorizontalLayout {
            alignment: center;
            padding-top: 30px;
            KreivoLogo {
                live: root.live;
                loading-step: root.loading-step;
            }
        }

        // --- Config URL (shown before metadata is loaded) ---
        if config-url != "" && block-number == 0: VerticalLayout {
            padding-top: 8px;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: "open in browser:";
                    color: #666;
                    font-size: 10px;
                }
            }
            HorizontalLayout {
                alignment: center;
                padding-top: 4px;
                Text {
                    text: config-url;
                    color: #7df;
                    font-size: 13px;
                }
            }
        }

        // --- Block number ---
        if block-number > 0: HorizontalLayout {
            padding-top: 8px;
            alignment: center;
            Text {
                text: block-text;
                color: #fff;
                font-size: 36px;
                font-weight: 700;
            }
        }

        // --- Collator grid (3×2) ---
        if block-number > 0: VerticalLayout {
            padding-top: 12px;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                CollatorBox { text: c0; active: c0-active; }
                CollatorBox { text: c1; active: c1-active; }
                CollatorBox { text: c2; active: c2-active; }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                CollatorBox { text: c3; active: c3-active; }
                CollatorBox { text: c4; active: c4-active; }
                CollatorBox { text: c5; active: c5-active; }
            }
        }
    }

    // ═══════════════════ INFO PAGE ═══════════════════
    if show-info: VerticalLayout {
        padding-top: 32px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 10px;

        Text { text: "Device Info"; color: #7df; font-size: 16px; font-weight: 600; }

        // Config URL
        if config-url != "": VerticalLayout {
            spacing: 2px;
            Text { text: "config page"; color: #666; font-size: 10px; }
            Text { text: config-url; color: #7df; font-size: 12px; }
        }

        // Metadata
        VerticalLayout {
            spacing: 2px;
            Text { text: "metadata"; color: #666; font-size: 10px; }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: meta-pallets > 0 ? "\{meta-pallets} pallets" : "not loaded";
                    color: meta-pallets > 0 ? #3d5 : #f54;
                    font-size: 12px;
                }
                if meta-types > 0: Text {
                    text: "\{meta-types} types";
                    color: #aaa;
                    font-size: 12px;
                }
            }
            Text {
                text: meta-saved ? "saved to flash" : "not persisted";
                color: meta-saved ? #3d5 : #888;
                font-size: 10px;
            }
        }

        // Heap
        if heap-free > 0: VerticalLayout {
            spacing: 2px;
            Text { text: "memory"; color: #666; font-size: 10px; }
            Text {
                text: "\{heap-free} KB free";
                color: #aaa;
                font-size: 12px;
            }
        }

        // Hint
        Rectangle {
            height: 20px;
        }
        HorizontalLayout {
            alignment: center;
            Text { text: "press button to go back"; color: #444; font-size: 9px; }
        }
    }

    // --- Status (always visible) ---
    if status != "": Rectangle {
        y: 214px; height: 24px; width: 240px;
        HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            Text {
                text: status;
                color: status-color;
                font-size: 10px;
            }
        }
    }
}
